# Backend configuration. Export these (or load them with your process manager) - Django does not read .env itself.
# Everything is optional for local development: DEBUG defaults to on and e-mails are printed to the console.

DJANGO_DEBUG=1
# REQUIRED when DJANGO_DEBUG=0:   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# React app (used in e-mailed links and for CORS/CSRF)
FRONTEND_URL=http://localhost:3000
# CORS_ALLOWED_ORIGINS=http://localhost:3000

# Real e-mail (Gmail needs an app password). Leave empty to print e-mails in the console.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
